# Copy to .env and fill in. .env is gitignored; never commit it.

# Server
PORT=3001
DATABASE_PATH=./data/vinyl.db

# Discogs: https://www.discogs.com/settings/developers -> "Generate new token"
DISCOGS_TOKEN=
# Discogs requires a descriptive User-Agent: AppName/version +contact-url
# Only for the end-to-end tests (they point it at a fake Discogs). Leave unset.
# DISCOGS_API_URL=https://api.discogs.com

DISCOGS_USER_AGENT=VinylTracker/0.1 +https://github.com/danielcoria/vinyl-tracker

# Online only: a site-wide password (at least 8 characters). Leave unset on
# your own computer. See docs/DEPLOY.md.
# APP_PASSWORD=

# Online only: "true" when the host puts a proxy in front of the app (most do).
# TRUST_PROXY=false

# Public demo only: "true" fills an empty database with sample albums and plays
# on start (see docs/DEPLOY.md). Leave unset for a real collection.
# DEMO_MODE=false
