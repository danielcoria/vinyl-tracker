// tsconfig.base.json: TYPESCRIPT SETTINGS SHARED BY ALL THREE FOLDERS
// TypeScript = JavaScript plus "types" (e.g. this is a number, that is text),
// so mistakes are caught before running the code (npm run typecheck).
// "strict" turns on the most careful checking.
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  }
}
